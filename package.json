{
  "name": "dpet",
  "version": "0.4.1",
  "description": "DPet — Four cats and two cockatiels (Liam, Ninoosh, Ozy, Slash, Toto and Chico)",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "DPet contributors",
  "license": "UNLICENSED",
  "homepage": "https://github.com/jaavid/DPet",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "web": "npm run assets && vite --host 127.0.0.1",
    "dev": "npm run assets && npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run assets && vitest run",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --external:electron-updater --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "npm run assets && npm run typecheck && vite build && npm run build:electron",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "wait-on": "9.5.1",
    "sharp": "0.35.5",
    "@electron/notarize": "3.1.1"
  },
  "build": {
    "appId": "app.dpet.desktop",
    "productName": "DPet",
    "copyright": "© 2026 DPet contributors",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterSign": "scripts/notarize.cjs",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DPet-Setup-${version}-${arch}.${ext}"
    },
    "artifactName": "DPet-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "jaavid",
      "repo": "DPet"
    },
    "linux": {
      "category": "Game",
      "synopsis": "Six animated desktop companions",
      "description": "Four cats and two cockatiels roam, rest and play on your desktop.",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DPet-${version}-linux-${arch}.${ext}",
      "maintainer": "DPet contributors <1959108+jaavid@users.noreply.github.com>",
      "syncDesktopName": true,
      "executableName": "dpet"
    },
    "description": "Six animated desktop companions: four cats and two cockatiels."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaavid/DPet.git"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "desktopName": "app.dpet.desktop"
}
