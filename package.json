{
  "name": "dpet",
  "version": "0.2.0",
  "description": "DPet — Liam & Ninoosh, two playful desktop companions",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "DPet contributors",
  "license": "UNLICENSED",
  "homepage": "https://github.com/jaavid/DPet",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "web": "npm run assets && vite --host 127.0.0.1",
    "dev": "npm run assets && npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "npm run assets && npm run typecheck && vite build && npm run build:electron",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "concurrently": "9.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.0.13",
    "wait-on": "8.0.4",
    "sharp": "0.34.4",
    "@electron/notarize": "3.1.0"
  },
  "build": {
    "appId": "app.dpet.desktop",
    "productName": "DPet",
    "copyright": "© 2026 DPet contributors",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterSign": "scripts/notarize.cjs",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DPet-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DPet-Portable-${version}-${arch}.${ext}"
    },
    "artifactName": "DPet-${version}-${os}-${arch}.${ext}"
  }
}
